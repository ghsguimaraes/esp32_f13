#include <BleKeyboard.h>

#define LED_PIN 2

const unsigned long INTERVALO = 60000;

BleKeyboard teclado("Logitech Keyboard", "Logitech", 100);

unsigned long ultimoEnvio = 0;
unsigned long ultimoPisca = 0;

bool ledEstado = false;
bool conectadoAnterior = false;

void setup() {
Serial.begin(115200);

pinMode(LED_PIN, OUTPUT);
digitalWrite(LED_PIN, LOW);

Serial.println();
Serial.println("================================");
Serial.println(" ANTI-IDLE ESP32");
Serial.println("================================");

teclado.begin();

Serial.println("Bluetooth iniciado.");
Serial.println("Aguardando conexao...");
}

void loop() {

unsigned long agora = millis();

// --------------------------------------------------
// DESCONECTADO
// --------------------------------------------------

if (!teclado.isConnected()) {

conectadoAnterior = false;

// LED piscando
if (agora - ultimoPisca >= 500) {
  ultimoPisca = agora;

  ledEstado = !ledEstado;
  digitalWrite(LED_PIN, ledEstado);
}

return;
}

// --------------------------------------------------
// CONECTADO
// --------------------------------------------------

digitalWrite(LED_PIN, HIGH);

// Detecta nova conexão
if (!conectadoAnterior) {

conectadoAnterior = true;

Serial.println();
Serial.println("*** BLUETOOTH CONECTADO ***");

// Pequena espera para garantir que o HID esteja pronto
delay(1000);

Serial.println("Enviando F13 de teste...");

teclado.press(KEY_F13);
delay(50);
teclado.release(KEY_F13);

Serial.println("F13 enviado!");

ultimoEnvio = agora;
}

// --------------------------------------------------
// ENVIO A CADA 1 MINUTO
// --------------------------------------------------

if (agora - ultimoEnvio >= INTERVALO) {

ultimoEnvio = agora;

Serial.println("Enviando F13...");

teclado.press(KEY_F13);
delay(50);
teclado.release(KEY_F13);

Serial.println("F13 enviado!");

// Indicação visual
for (int i = 0; i < 10; i++) {
  digitalWrite(LED_PIN, LOW);
  delay(100);

  digitalWrite(LED_PIN, HIGH);
  delay(100);
}
}
}
